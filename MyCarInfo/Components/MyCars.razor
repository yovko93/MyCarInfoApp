<!--==================== MY CARS ====================-->
﻿@using MyCarInfo.Data
@inject ICarService CarService
@implements IDisposable
@using System.Threading

<AuthorizeView>
    <Authorized>
        <section class="popular section" id="my-cars">
            <h2 class="section__title">
                Моите автомобили
            </h2>

            @if (isLoading)
            {
                <div class="my-cars__container container">
                    <div class="popular__loading">Зареждаме информация за автомобилите ви...</div>
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="my-cars__container container">
                    <div class="popular__error">@errorMessage</div>
                </div>
            }
            else if (cars.Count == 0)
            {
                <div class="my-cars__container container">
                    <div class="popular__empty">Все още нямате добавени автомобили.</div>
                </div>
            }
            else
            {
                <div class="my-cars__container container swiper">
                    <div class="swiper-wrapper">
                        @foreach (var car in CurrentPageCars)
                        {
                            <article class="mycar__card swiper-slide">
                                <div class="shapeX shape__smaller"></div>

                                <h1 class="mycar__title">@car.Brand</h1>
                                <h3 class="mycars__subtitle">@car.Model</h3>

                                <img src="@GetPrimaryImage(car)" alt="@GetCarAlt(car)" class="mycar__img">

                                <div class="mycar__data">
                                    <div class="mycar__data-group">
                                       <i class="ri-dashboard-2-line"></i> @car.Engine
                                    </div>
                                    <div class="mycar__data-group">
                                        <i class="ri-timer-2-line"></i> @car.HorsePower hp
                                    </div>
                                    <div class="mycar__data-group">
                                        <i class="ri-hashtag"></i> @car.LicensePlate
                                    </div>
                                </div>

                                <div class="mycar__dates">
                                    <span><i class="ri-shield-check-line"></i> ГО: @car.InsuranceExpiryDate.ToString("dd.MM.yyyy")</span>
                                    <span><i class="ri-tools-line"></i> ГТП: @car.InspectionExpiryDate.ToString("dd.MM.yyyy")</span>
                                    <span><i class="ri-roadster-line"></i> Винетка: @car.VignetteExpiryDate.ToString("dd.MM.yyyy")</span>
                                </div>
                                <NavLink class="my-cars__details-link" href="@($"/my-car/{car.Id}")">
                                    Детайли
                                    <i class="ri-arrow-right-line"></i>
                                </NavLink>
                            </article>
                        }
                    </div>
                    @if (totalPages > 1)
                    {
                        <div class="slider__bg">
                            @for (var i = 0; i < totalPages; i++)
                            {
                                <div class="slider__bg-navBtn @(currentPage == i ? "active" : string.Empty)"
                                     role="button"
                                     tabindex="0"
                                     @onclick="() => SetPage(i)">
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </section>
    </Authorized>
</AuthorizeView>

@code {
    private const int PageSize = 3;
    private List<Vehicle> cars = new();
    private bool isLoading = true;
    private string? errorMessage;
    private int currentPage = 0;
    private int totalPages = 0;
    private Timer? autoPageTimer;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateTask;
        var isAuthenticated = authenticationState.User.Identity?.IsAuthenticated ?? false;

        if (!isAuthenticated)
        {
            isLoading = false;
            return;
        }

        try
        {
            cars = await CarService.GetCurrentUserCarsAsync();
            totalPages = (int)Math.Ceiling((double)cars.Count / PageSize);
            currentPage = totalPages > 0 ? Math.Min(currentPage, totalPages - 1) : 0;
            StartAutoPaging();
        }
        catch (Exception)
        {
            errorMessage = "Неуспешно зареждане на автомобилите ви.";
        }
        finally
        {
            isLoading = false;
        }
    }

    public void Dispose()
    {
        autoPageTimer?.Dispose();
    }

    private IEnumerable<Vehicle> CurrentPageCars => cars.Skip(currentPage * PageSize).Take(PageSize);

    private void SetPage(int pageIndex)
    {
        if (pageIndex < 0 || pageIndex >= totalPages)
        {
            return;
        }

        currentPage = pageIndex;
        StateHasChanged();
    }

    private void NextPage()
    {
        if (totalPages <= 1)
        {
            return;
        }

        currentPage = (currentPage + 1) % totalPages;
        InvokeAsync(StateHasChanged);
    }

    private void StartAutoPaging()
    {
        autoPageTimer?.Dispose();

        if (totalPages <= 1)
        {
            return;
        }

        autoPageTimer = new Timer(_ => NextPage(), null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private static string GetPrimaryImage(Vehicle car)
    {
        return car.Images.FirstOrDefault()?.ImagePath ?? "/img/popular1.png";
    }

    private static string GetCarAlt(Vehicle car)
    {
        return $"{car.Brand} {car.Model}";
    }
}
