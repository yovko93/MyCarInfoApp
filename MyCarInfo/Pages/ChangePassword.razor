@page "/changePassword"

@attribute [Authorize]
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Change Password</PageTitle>

<Header />

<section class="section auth">
    <div class="container auth__container grid">
        <div class="auth__intro">
            <p class="section__title">Сигурност</p>
            <h2 class="auth__headline">Промени паролата си</h2>
            <p class="auth__description">
                Използвай текущата си парола и въведи нова, за да защитиш профила си.
            </p>
        </div>

        <div class="auth__card">
            <EditForm Model="changePasswordModel" OnValidSubmit="HandlePasswordChange" class="auth__form">
                <DataAnnotationsValidator />
                <ValidationSummary class="alert auth__alert" />
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert auth__alert">@errorMessage</div>
                }

                <div class="auth__grid">
                    <div class="auth__field">
                        <label for="current-password">Текуща парола</label>
                        <InputText id="current-password" type="password" class="auth__input" placeholder="Текуща парола" @bind-Value="changePasswordModel.CurrentPassword" />
                    </div>
                    <div class="auth__field">
                        <label for="new-password">Нова парола</label>
                        <InputText id="new-password" type="password" class="auth__input" placeholder="Нова парола" @bind-Value="changePasswordModel.NewPassword" />
                    </div>
                    <div class="auth__field">
                        <label for="confirm-new-password">Потвърди новата парола</label>
                        <InputText id="confirm-new-password" type="password" class="auth__input" placeholder="Потвърди новата парола" @bind-Value="changePasswordModel.ConfirmNewPassword" />
                    </div>
                </div>

                <button class="button auth__submit" type="submit">Запази промените</button>
                <div class="auth__actions">
                    <NavLink href="/" class="button auth__home">
                        <i class="ri-home-5-line"></i>
                        Към началната страница
                    </NavLink>
                </div>
            </EditForm>
        </div>

        <div class="auth__intro">
            <div class="auth__highlights">
                <div class="auth__highlight">
                    <i class="ri-lock-password-line"></i>
                    Избери силна парола, която да помниш.
                </div>
                <div class="auth__highlight">
                    <i class="ri-shield-user-line"></i>
                    Смяната на паролата повишава сигурността ти.
                </div>
                <div class="auth__highlight">
                    <i class="ri-key-line"></i>
                    Не споделяй паролата си с други хора.
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private ChangePasswordModel changePasswordModel = new();
    private string errorMessage = string.Empty;

    private async Task HandlePasswordChange()
    {
        errorMessage = string.Empty;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var result = await AuthService.ChangePasswordAsync(changePasswordModel, authState.User);

        if (!result.Succeeded)
        {
            errorMessage = result.Error;
            return;
        }

        NavigationManager.NavigateTo("/?passwordChanged=true");
    }
}