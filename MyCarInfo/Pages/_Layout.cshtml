@using Microsoft.AspNetCore.Components.Web
@namespace MyCarInfo.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="preconnect" href="https://code.jquery.com" />
    <link rel="preconnect" href="https://stackpath.bootstrapcdn.com" />

    <!--=============== FAVICON ===============-->
    <link rel="shortcut icon" href="./img/favicon.png" type="image/x-icon" class="favicon" asp-append-version="true">

    <!--=============== REMIX ICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@2.5.0/fonts/remixicon.css" rel="stylesheet">

    <!--=============== SWIPER CSS ===============-->
    <link rel="stylesheet" href="./css/swiper-bundle.min.css" asp-append-version="true">

    <!--=============== CSS ===============-->
    <link rel="stylesheet" href="./css/styles.css" asp-append-version="true">

    <title>My Car Info App</title>

    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />

    <script>
        (function () {
            const storedTheme = localStorage.getItem('theme');
            const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
            const theme = storedTheme || (prefersLight ? 'light' : 'dark');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
</head>
<body>
    <div class="preloader" id="preloader" role="status" aria-live="polite">
        <div class="preloader__spinner" aria-hidden="true">
            <span class="preloader__ring"></span>
            <span class="preloader__ring preloader__ring--accent"></span>
        </div>
        <span class="preloader__text">Loading your garage...</span>
    </div>

    @RenderBody()

    <script src="_framework/blazor.server.js"></script>

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js" defer></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.bundle.min.js" defer></script>

    <!--========== SCROLL UP ==========-->

    <a href="" class="scrollup" id="scroll-up">
        <i class="ri-arrow-up-s-line"></i>
    </a>

    <!--=============== SCROLL REVEAL - PAGE ANNIMATION ===============-->
    <script src="~/js/scrollrevealAnimation.min.js" asp-append-version="true" defer></script>

    <!--=============== SWIPER JS - PRODUCT SLIDER ===============-->
    <script src="~/js/swiper-bundle.min.js" asp-append-version="true" defer></script>

    <!--=============== MIXITUP JS - FILTER PRODUCT ===============-->
    <script src="~/js/mixitup.min.js" asp-append-version="true" defer></script>

    <!--=============== MAIN JS ===============-->
    <script src="~/js/main.js" asp-append-version="true" defer></script>

    <script>
        (() => {
            const root = document.documentElement;
            const updateToggleState = () => {
                const themeToggle = document.getElementById('theme-toggle');
                if (!themeToggle) {
                    return;
                }

                const theme = root.getAttribute('data-theme') || 'dark';
                themeToggle.setAttribute('aria-pressed', theme === 'dark');

                const icon = themeToggle.querySelector('i');
                const label = themeToggle.querySelector('.nav__theme-label');

                if (icon) {
                    icon.className = theme === 'dark' ? 'ri-moon-line' : 'ri-sun-line';
                }

                if (label) {
                    label.textContent = theme === 'dark' ? 'Dark' : 'Light';
                }
            };

            const toggleTheme = () => {
                const nextTheme = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                root.setAttribute('data-theme', nextTheme);
                localStorage.setItem('theme', nextTheme);
                updateToggleState();
            };

            document.addEventListener('click', (event) => {
                const target = event.target instanceof Element ? event.target.closest('#theme-toggle') : null;
                if (!target) {
                    return;
                }

                toggleTheme();
            });

            document.addEventListener('DOMContentLoaded', updateToggleState);
            window.addEventListener('load', updateToggleState);
        })();
    </script>

    <script>
        window.addEventListener('load', () => {
            const preloader = document.getElementById('preloader');
            if (!preloader) return;
            preloader.classList.add('preloader--hide');
            preloader.addEventListener('transitionend', () => preloader.remove());
        });
    </script>

    <script>
        // This example adds a marker to indicate the position of Bondi Beach in Sydney,
        // Australia.
        function initMap() {
            var map = new google.maps.Map(document.getElementById('map'), {
                zoom: 11,
                center: { lat: 40.645037, lng: -73.880224 },
            });

            var image = 'images/location_point.png';
            var beachMarker = new google.maps.Marker({
                position: { lat: 40.645037, lng: -73.880224 },
                map: map,
                icon: image
            });
        }
    </script>
    @*    <!-- google map js -->
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyA8eaHt9Dh5H57Zh0xVTqxVdBFCvFMqFjQ&callback=initMap"></script>
    <!-- end google map js --> *@
</body>
</html>
