@page "/login"
@model MyCarInfo.Pages.LoginModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Login";
}

<section class="section auth">
    <div class="container auth__container grid">

        <div class="auth__intro">
            <p class="section__title">Добре дошъл обратно</p>
            <h2 class="auth__headline">Влез в своя MyCarInfo акаунт</h2>
            <p class="auth__description">
                Достъпи таблото си, прегледай гаража и получавай напомняния за важни срокове и поддръжки. Всичко е
                подредено, за да следиш автомобила си без усилие.
            </p>
        </div>

        <div class="auth__card">
            <form method="post" class="auth__form">
                @Html.AntiForgeryToken()

                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <input type="hidden" name="message" value="@Model.InfoMessage" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                @if (Model.InfoMessage != null)
                {
                    <div class="alert alert-info auth__alert">@Model.InfoMessage</div>
                }

                @if (Model.ErrorMessage != null)
                {
                    <div class="alert alert-danger auth__alert">@Model.ErrorMessage</div>
                }

                <div class="auth__grid">
                    <div class="auth__field">
                        <label asp-for="Input.Username">Потребителско име</label>
                        <input name="Input.Username" class="auth__input" autocomplete="username" aria-required="true" placeholder="Въведи потребителско име" />
                        <span asp-validation-for="Input.Username" class="text-danger"></span>
                    </div>

                    <div class="auth__field">
                        <label asp-for="Input.Password">Парола</label>
                        <input name="Input.Password" type="password" class="auth__input" autocomplete="current-password" aria-required="true" placeholder="Въведи парола" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="button auth__submit">Вход</button>

                <div class="auth__actions">
                    <a href="/" class="button auth__home">
                        <i class="ri-home-5-line"></i>
                        Към началната страница
                    </a>
                </div>

                <p class="auth__footer">
                    Нямаш акаунт?
                    <a href="/register" class="auth__link">Регистрирай се тук</a>.
                </p>
            </form>
        </div>

        <div class="auth__intro">
            <div class="auth__highlights">
                <div class="auth__highlight">
                    <i class="ri-shield-keyhole-line"></i>
                    Сигурен достъп до всички данни за автомобила ти.
                </div>
                <div class="auth__highlight">
                    <i class="ri-notification-3-line"></i>
                    Получавай известия преди изтичане на документи и обслужвания.
                </div>
            </div>
        </div>
    </div>
</section>
