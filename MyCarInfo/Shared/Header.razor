<!--==================== HEADER ====================-->
<header class="header" id="header">
    <nav class="nav container">
        <a href="" class="nav__logo">
            <i class="ri-steering-fill"></i>
            MyCarInfo
        </a>
        <div class="nav__menu" id="nav-menu">
            <ul class="nav__list">
                <li class="nav__item"><a href="#home" class="nav__link active-link">Home</a></li>
                <li class="nav__item"><a href="#about" class="nav__link ">About</a></li>
                <li class="nav__item"><a href="#my-cars" class="nav__link">My Cars</a></li>
                <li class="nav__item"><a href="#featured" class="nav__link">Featured</a></li>
              
            </ul>

            <div class="nav__close" id="nav-close">
                <i class="ri-close-line"></i>
            </div>
        </div>

        <!-- Togglar Button -->
        <div class="nav__toggle" id="nav-toggle">
            <i class="ri-menu-line"></i>
        </div>

        <!-- Login / Logout Buttons -->
        <div class="nav__auth-buttons">
            <AuthorizeView>
                <Authorized>
                    <span class="nav__item" id="username-display">Hello user</span>
                    <a class="nav__link btn-link" @onclick="Logout">Logout</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="nav__link">Login</a>
                    <a href="/register" class="nav__link">Register</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </nav>
</header>

@code {
    private IAuthService AuthService { get; set; }
    private NavigationManager NavigationManager { get; set; }
    private AuthenticationStateProvider AuthStateProvider { get; set; }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();

        NavigationManager.NavigateTo("/");
    }
}
