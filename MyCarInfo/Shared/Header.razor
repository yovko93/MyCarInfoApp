<!--==================== HEADER ====================-->
<header class="header" id="header">
    <nav class="nav container">
        <AuthorizeView>
            <Authorized Context="authState">
                <span class="nav__item" id="username-display">Здравейте, @authState.User.Identity?.Name</span>
            </Authorized>
        </AuthorizeView>
        <a href="/" class="nav__logo">
            <i class="ri-steering-fill"></i>
            MyCarInfo
        </a>
        <div class="nav__menu" id="nav-menu">
            <ul class="nav__list">
                <li class="nav__item"><a href="#about" class="nav__link ">За нас</a></li>
                <li class="nav__item"><a href="#gallery" class="nav__link">Галерия</a></li>
                <AuthorizeView>
                    <Authorized Context="authState">
                        <li class="nav__item"><a href="#my-cars" class="nav__link">Моите коли</a></li>
                        <li class="nav__item"><a href="/register-car" class="nav__link">Добави кола</a></li>
                    </Authorized>
                </AuthorizeView>
            </ul>

            <div class="nav__close" id="nav-close">
                <i class="ri-close-line"></i>
            </div>
        </div>

        <!-- Togglar Button -->
        <div class="nav__toggle" id="nav-toggle">
            <i class="ri-menu-line"></i>
        </div>

        <button class="nav__theme-toggle" id="theme-toggle" type="button" aria-label="Toggle theme" aria-pressed="false">
            <i class="ri-moon-line" aria-hidden="true"></i>
            <span class="nav__theme-label">Dark</span>
        </button>

        <!-- Login / Logout Buttons -->
        <div class="nav__auth-buttons">
            <AuthorizeView>
                <Authorized Context="authState">
                    <div class="nav__profile @(isProfileMenuOpen ? "nav__profile--open" : string.Empty)">
                        <button class="nav__profile-toggle" type="button" aria-haspopup="true" aria-expanded="@isProfileMenuOpen" @onclick="ToggleProfileMenu">
                            <i class="ri-user-3-line"></i>
                            Профил
                            <i class="ri-arrow-down-s-line"></i>
                        </button>
                        <div class="nav__profile-menu">
                            <div class="nav__profile-section">
                                <a href="/profile" class="nav__profile-link">Моите данни</a>
                            </div>
                            <div class="nav__profile-section">
                                <a href="/changePassword" class="nav__profile-link">Промяна на парола</a>
                            </div>
                            <button class="nav__profile-link nav__profile-button" type="button" @onclick="Logout">Изход</button>
                        </div>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="nav__link">Вход</a>
                    <span>/</span>
                    <a href="/register" class="nav__link">Регистрация</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </nav>
</header>

@code {
    private bool isProfileMenuOpen;

    [Inject]
    private NavigationManager NavigationManager { get; set; }

    private void Logout() => NavigationManager.NavigateTo("/logout", true);

    private void ToggleProfileMenu() => isProfileMenuOpen = !isProfileMenuOpen;
}
