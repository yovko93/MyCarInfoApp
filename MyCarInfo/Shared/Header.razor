<!--==================== HEADER ====================-->
<header class="header" id="header">
    <nav class="nav container">
        <AuthorizeView>
            <Authorized Context="authState">
                <span class="nav__item" id="username-display">Здравей, @authState.User.Identity?.Name</span>
            </Authorized>
        </AuthorizeView>
        <a href="/" class="nav__logo">
            <i class="ri-steering-fill"></i>
            MyCarInfo
        </a>
        <div class="nav__menu" id="nav-menu">
            <ul class="nav__list">
                <li class="nav__item"><a href="#about" class="nav__link ">About</a></li>
                <li class="nav__item"><a href="#my-cars" class="nav__link">My Cars</a></li>
                <li class="nav__item"><a href="#gallery" class="nav__link">Gallery</a></li>
                <AuthorizeView>
                    <Authorized Context="authState">
                        <li class="nav__item"><a href="/register-car" class="nav__link">Add your Car</a></li>
                    </Authorized>
                </AuthorizeView>
            </ul>

            <div class="nav__close" id="nav-close">
                <i class="ri-close-line"></i>
            </div>
        </div>

        <!-- Togglar Button -->
        <div class="nav__toggle" id="nav-toggle">
            <i class="ri-menu-line"></i>
        </div>

        <!-- Login / Logout Buttons -->
        <div class="nav__auth-buttons">
            <AuthorizeView>
                <Authorized Context="authState">
                    <a class="nav__link btn-link" @onclick="Logout">Изход</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="nav__link">Login</a>
                    <a href="/register" class="nav__link">Register</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </nav>
</header>

@code {
    [Inject]
    private NavigationManager NavigationManager { get; set; }

    private void Logout() => NavigationManager.NavigateTo("/logout", true);
}
