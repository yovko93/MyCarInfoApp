{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Viber": {
    "VIBER_BOT_TOKEN": "VIBER_BOT_TOKEN",
    "SenderName": "MyCarInfo",
    "ApiUrl": "https://chatapi.viber.com/pa/send_message",
    "BotUri": "https://share.hsforms.com/VIBER_BOT_TOKEN",
    "WebhookUrl": "https://localhost:5001/api/viber/webhook",
    "WebhookApiUrl": "https://chatapi.viber.com/pa/set_webhook"
  },
  "Notifications": {
    "CheckIntervalMinutes": 1,
    "CheckIntervalDays": 1
  },
  "Email": {
    "Host": "smtp.example.com",
    "Port": 587,
    "SenderEmail": "no-reply@mycarinfo.local",
    "SenderName": "MyCarInfo",
    "Username": "smtp-username",
    "Password": "smtp-password",
    "EnableSsl": true
  }
}
