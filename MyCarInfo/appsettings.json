{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=MyCarInfoDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Viber": {
    "VIBER_BOT_TOKEN": "VIBER_BOT_TOKEN",
    "SenderName": "MyCarInfo",
    "ApiUrl": "https://chatapi.viber.com/pa/send_message"
  },
  "Notifications": {
    "CheckIntervalMinutes": 1,
    "CheckIntervalDays": 1
  },
  "AllowedHosts": "*"
}
